  requested_units numeric(18,6) [not null, note: "DecimalField."]
  approved_units numeric(18,6) [not null, note: "DecimalField."]
  conversion_rate_snapshot numeric(18,2) [not null, note: "DecimalField money per unit."]
  calculated_amount numeric(18,2) [not null, note: "DecimalField money."]
  approved_amount numeric(18,2) [not null, note: "DecimalField money."]
  currency varchar(3) [not null, note: "CharField(3)."]
  target_payroll_period_id bigint [null, note: "nullable FK -> PayrollPeriod, PROTECT."]
  reason text [not null, note: "TextField."]
  status varchar [not null, note: "draft, submitted, approved, rejected, posted, cancelled, reversed."]
  approved_by_id bigint [null, note: "nullable FK -> User/DateTimeField."]
  approved_at timestamptz [null, note: "nullable FK -> User/DateTimeField."]
  source_key varchar [not null, note: "CharField idempotency key."]
  reversal_of_id bigint [null, note: "nullable FK -> self, PROTECT."]
  Note: "LeaveEncashment | Direct company ownership. Constraint: approved units cannot exceed eligible available balance. Resulting payroll lines point back to this row, so reversals and off-cycle corrections remain possible."
}

