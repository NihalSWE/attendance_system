Table payroll_run {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  payroll_period_id bigint [not null, note: "FK -> PayrollPeriod, PROTECT."]
  run_type varchar [not null, note: "regular, correction, off_cycle, final_settlement, reversal."]
  revision_number integer [not null, note: "PositiveIntegerField."]
  source_run_id bigint [null, note: "nullable FK -> self, PROTECT for correction/reversal."]
  policy_version_id bigint [not null, note: "FK -> PayrollPolicyVersion, PROTECT."]
  salary_structure_snapshot jsonb [null, note: "JSONField, optional run-level metadata only."]
  attendance_cutoff_at timestamptz [not null, note: "DateTimeField."]
  leave_cutoff_at timestamptz [not null, note: "DateTimeField."]
  adjustment_cutoff_at timestamptz [not null, note: "DateTimeField."]
  idempotency_key varchar [not null, note: "CharField."]
  status varchar [not null, note: "draft, queued, calculating, review, approved, posted, failed, cancelled, reversed."]
  calculation_started_at timestamptz [null, note: "nullable DateTimeField."]
  calculation_finished_at timestamptz [null, note: "nullable DateTimeField."]
  generated_by_id bigint [null, note: "nullable FK -> User, SET_NULL/PROTECT according to audit policy."]
  approved_by_id bigint [null, note: "nullable FK -> User, SET_NULL/PROTECT according to audit policy."]
  posted_by_id bigint [null, note: "nullable FK -> User, SET_NULL/PROTECT according to audit policy."]
  approved_at timestamptz [null, note: "nullable DateTimeField."]
  posted_at timestamptz [null, note: "nullable DateTimeField."]
  failure_code varchar [not null, note: "blank CharField/TextField."]
  failure_message text [not null, note: "blank CharField/TextField."]
  totals_snapshot jsonb [not null, note: "JSONField."]
  Note: "PayrollRun | Direct company ownership. Constraints: unique `(company, idempotency_key)` and `(payroll_period, run_type, revision_number)`; only one posted regular result chain may be authoritative for an employee/period."
}

Table payroll_record {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  payroll_run_id bigint [not null, note: "FK -> PayrollRun, PROTECT."]
  employee_id bigint [not null, note: "FK -> Employee, PROTECT."]
  employee_assignment_at_period_end_id bigint [null, note: "nullable FK -> EmployeeAssignment, PROTECT."]
  currency varchar(3) [not null, note: "CharField(3)."]
  gross_earnings numeric(18,2) [not null, note: "DecimalField money."]
  total_earnings numeric(18,2) [not null, note: "DecimalField money."]
  total_deductions numeric(18,2) [not null, note: "DecimalField money."]
  employer_contributions numeric(18,2) [not null, note: "DecimalField money."]
  reimbursements numeric(18,2) [not null, note: "DecimalField money."]
  net_pay numeric(18,2) [not null, note: "DecimalField money."]
  paid_amount numeric(18,2) [not null, note: "DecimalField cached summaries; authoritative values come from payment allocations."]
  outstanding_amount numeric(18,2) [not null, note: "DecimalField cached summaries; authoritative values come from payment allocations."]
  calculation_snapshot jsonb [not null, note: "JSONField containing frozen inputs/totals."]
  status varchar [not null, note: "draft, calculated, review, approved, posted, partially_paid, paid, void, reversed."]
  approved_by_id bigint [null, note: "nullable FK -> User/DateTimeField."]
  approved_at timestamptz [null, note: "nullable FK -> User/DateTimeField."]
  posted_at timestamptz [null, note: "nullable DateTimeField."]
  reversal_of_id bigint [null, unique, note: "nullable O2O -> self, PROTECT."]
  Note: "PayrollRecord | Direct company ownership. Constraints: unique `(payroll_run, employee)`; employee belongs to run company; totals equal active line sums and allocations cannot exceed payable balance."
}

Table payroll_compensation_segment {
