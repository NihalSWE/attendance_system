  payroll_daily_line_id bigint [null, note: "nullable FK -> PayrollDailyLine, PROTECT."]
  salary_component_id bigint [not null, note: "FK -> SalaryComponent, PROTECT."]
  source_type varchar [not null, note: "base_compensation, attendance, penalty, overtime, bonus, adjustment, advance_recovery, loan_repayment, leave_encashment, lfa, manual, reversal."]
  penalty_assessment_id bigint [null, note: "nullable FK -> PenaltyAssessment, PROTECT."]
