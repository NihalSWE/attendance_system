  approver_membership_id bigint [not null, note: "FK -> CompanyMembership, PROTECT."]
  delegated_from_membership_id bigint [null, note: "nullable FK -> CompanyMembership, PROTECT."]
  status varchar [not null, note: "pending, approved, rejected, skipped, cancelled."]
  decision varchar [null, note: "nullable approve/reject."]
  comment text [not null, note: "TextField."]
  decided_at timestamptz [null, note: "nullable DateTimeField."]
  route_snapshot jsonb [not null, note: "JSONField."]
  Note: "LeaveApprovalStep | Direct company ownership. Constraints: exactly one target FK; unique target/stage/approver; decision fields required when decided."
}

