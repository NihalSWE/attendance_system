  Note: "SalaryStructure | Direct company ownership. Relations: components are M2M -> SalaryComponent through SalaryStructureComponent.\nConstraints: unique `(company, code, version_number)`; at most one active default structure for a company/date; activated structures are immutable except retirement metadata."
}

Table payroll_salary_structure_component {
