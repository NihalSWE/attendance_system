  }
  Note: "EmployeePermissionOverride_allowed_branches | Parent-owned junction. Unique pair; both rows must belong to the same company. Tenant ownership is inherited from the source parent; this implicit junction has no company_id."
}

Table access_control_employeepermissionoverride_allowed_departments {
  id bigint [pk, increment, not null]
  employeepermissionoverride_id bigint [not null]
  department_id bigint [not null]
  indexes {
    (employeepermissionoverride_id, department_id) [unique]
  }
  Note: "EmployeePermissionOverride_allowed_departments | Parent-owned junction. Unique pair; both rows must belong to the same company. Tenant ownership is inherited from the source parent; this implicit junction has no company_id."
}

Table payroll_payrolldailyline_leave_days {
  id bigint [pk, increment, not null]
  payrolldailyline_id bigint [not null]
  leaveday_id bigint [not null]
  indexes {
    (payrolldailyline_id, leaveday_id) [unique]
  }
  Note: "PayrollDailyLine_leave_days | Parent-owned junction. Unique pair; both rows must belong to the same company. Tenant ownership is inherited from the source parent; this implicit junction has no company_id."
}

