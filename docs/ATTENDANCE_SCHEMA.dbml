  reimbursements numeric(18,2) [not null, note: "DecimalField money."]
  net_pay numeric(18,2) [not null, note: "DecimalField money."]
  paid_amount numeric(18,2) [not null, note: "DecimalField cached summaries; authoritative values come from payment allocations."]
