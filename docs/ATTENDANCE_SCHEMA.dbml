  name varchar [not null, note: "CharField."]
  frequency varchar [not null, note: "monthly initially."]
  period_start date [not null, note: "DateField, inclusive business dates."]
  period_end date [not null, note: "DateField, inclusive business dates."]
  attendance_cutoff_at timestamptz [null, note: "nullable DateTimeField."]
  adjustment_cutoff_at timestamptz [null, note: "nullable DateTimeField."]
