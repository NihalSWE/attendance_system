// Proposed attendance schema. Documentation only; no database has been created.
// All domain columns and FKs; advanced cross-row constraints are retained as notes.
// Django auth/framework tables are intentionally external to this domain schema.
Project attendance_management {
  database_type: 'PostgreSQL'
  Note: '83 domain models + 5 implicit M2M tables. Types and nullability are proposed; read FULL_DATABASE_SCHEMA.md for conventions.'
}

Table accounts_user {
  id bigint [pk, increment, not null, note: "BigAutoField, PK."]
  email varchar [not null, unique, note: "EmailField, unique, login identifier."]
  username varchar [not null, unique, note: "CharField, unique compatibility identifier if retaining AbstractUser; generated/internal when login is email."]
  first_name varchar [not null, note: "CharField."]
  last_name varchar [not null, note: "CharField."]
  phone varchar [not null, note: "CharField, blank."]
  timezone varchar [not null, note: "CharField preferences."]
  language varchar [not null, note: "CharField preferences."]
  password varchar [not null, note: "Django authentication fields."]
  last_login timestamptz [null, note: "Django authentication fields."]
  date_joined timestamptz [not null, note: "Django authentication fields."]
  is_active boolean [not null, note: "Django account flags. Platform root is `is_superuser=True`."]
  is_staff boolean [not null, note: "Django account flags. Platform root is `is_superuser=True`."]
  is_superuser boolean [not null, note: "Django account flags. Platform root is `is_superuser=True`."]
  created_at timestamptz [not null, note: "timestamps."]
  updated_at timestamptz [not null, note: "timestamps."]
  Note: "User | Global/platform scope; AuditLog company is optional. Relations: memberships, optional employee links, and actor/audit relations. Deactivate accounts instead of deleting them."
}

Table accounts_company_membership {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  user_id bigint [not null, note: "FK -> User, PROTECT."]
  role varchar [not null, note: "CharField choices: owner, company_admin, hr, manager, payroll_manager, employee, auditor."]
  status varchar [not null, note: "CharField choices: invited, active, suspended, ended."]
  joined_at timestamptz [null, note: "nullable DateTimeField."]
  ended_at timestamptz [null, note: "nullable DateTimeField."]
  invited_by_id bigint [null, note: "nullable FK -> User, SET_NULL."]
  last_access_at timestamptz [null, note: "nullable DateTimeField."]
  Note: "CompanyMembership | Direct company ownership. Constraints: unique `(company, user)`; departments selected in scope must belong to a selected/allowed branch and the same company. The two M2M fields create implicit junction tables unless later replaced by an explicit scope model."
}

Table tenants_company {
  id bigint [pk, increment, not null, note: "BigAutoField, PK."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  public_id uuid [not null, unique, note: "UUIDField, unique, immutable external identifier."]
  code varchar [not null, unique, note: "unique CharField identifiers."]
  slug varchar [not null, unique, note: "unique CharField identifiers."]
  name varchar [not null, note: "CharField."]
  legal_name varchar [not null, note: "CharField."]
  timezone varchar [not null, note: "CharField, default chosen during setup."]
  currency varchar(3) [not null, note: "CharField(3), ISO code."]
  language varchar [not null, note: "CharField."]
  country_code varchar [not null, note: "CharField."]
  email varchar [not null, note: "contact fields."]
  phone varchar [not null, note: "contact fields."]
  address text [not null, note: "contact fields."]
  registration_number varchar [null, note: "optional CharField."]
  tax_identifier varchar [null, note: "optional CharField."]
  logo varchar [null, note: "optional ImageField/private media reference."]
  status varchar [not null, note: "choices: trial, active, suspended, inactive."]
  activated_at timestamptz [null, note: "nullable DateTimeField."]
  suspended_at timestamptz [null, note: "nullable DateTimeField."]
  suspended_by_id bigint [null, note: "nullable FK -> User, SET_NULL."]
  suspension_reason text [not null, note: "TextField, blank."]
  Note: "Company | Global/platform scope; AuditLog company is optional. Relations: root of all tenant-owned rows; CompanyMembership, Branch, CompanyFeature, CompanySubscription, settings, employees, and operational records."
}

Table tenants_feature {
  id bigint [pk, increment, not null, note: "BigAutoField, PK."]
  code varchar [not null, unique, note: "CharField, unique, such as attendance, leave, payroll."]
  name varchar [not null, note: "display fields."]
  description text [not null, note: "display fields."]
  is_core boolean [not null, note: "BooleanField; core features cannot be removed from eligible packages."]
  is_active boolean [not null, note: "BooleanField."]
  sort_order integer [not null, note: "PositiveIntegerField."]
  created_at timestamptz [not null, note: "timestamps."]
  updated_at timestamptz [not null, note: "timestamps."]
  Note: "Feature | Global/platform scope; AuditLog company is optional. Relations: PackageFeature, CompanyFeature, AccessPermission."
}

Table tenants_company_feature {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  feature_id bigint [not null, note: "FK -> Feature, PROTECT."]
  effect varchar [not null, note: "choices: enable, disable."]
  starts_at timestamptz [null, note: "nullable DateTimeField."]
  ends_at timestamptz [null, note: "nullable DateTimeField."]
  limits jsonb [not null, note: "JSONField for feature-specific scalar limits, validated by feature."]
  reason text [not null, note: "TextField."]
  granted_by_id bigint [not null, note: "FK -> User, PROTECT."]
  is_active boolean [not null, note: "BooleanField."]
  Note: "CompanyFeature | Direct company ownership. Constraints: prevent overlapping active overrides for the same company/feature/effect. Effective access combines package snapshot and this dated override."
}

Table organization_branch {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  code varchar [not null, note: "CharField."]
  name varchar [not null, note: "CharField."]
  address text [not null, note: "location fields."]
  city varchar [not null, note: "location fields."]
  postal_code varchar [not null, note: "location fields."]
  country_code varchar [not null, note: "location fields."]
  timezone varchar [not null, note: "CharField; defaults from Company."]
  email varchar [null, note: "optional contact fields."]
  phone varchar [null, note: "optional contact fields."]
  is_default boolean [not null, note: "BooleanField."]
  status varchar [not null, note: "choices: active, inactive."]
  device_attendance_scope_override varchar [null, note: "nullable CharField: assigned_devices, department_devices, branch_devices, company_devices; null inherits CompanyAttendanceSettings. This is the employee's assigned/home branch policy, not the source device branch's policy."]
  opened_on date [null, note: "nullable DateField."]
  closed_on date [null, note: "nullable DateField."]
  Note: "Branch | Direct company ownership. Constraints: unique `(company, code)`; one active default branch per company."
}

Table organization_department {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  code varchar [not null, unique, note: "CharField, globally unique."]
  name varchar [not null, unique, note: "CharField, globally unique."]
  description text [not null, note: "TextField, blank."]
  status varchar [not null, note: "active/inactive."]
  Note: "Department | Global/platform scope; AuditLog company is optional. Relations: Designation, CompanyDepartment."
}

Table organization_designation {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  code varchar [not null, unique, note: "CharField, globally unique."]
  name varchar [not null, unique, note: "CharField, globally unique."]
  description text [not null, note: "TextField, blank."]
  status varchar [not null, note: "active/inactive."]
  Note: "Designation | Global/platform scope; AuditLog company is optional. "
}

Table organization_company_department {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  branch_id bigint [not null, note: "FK -> Branch, PROTECT."]
  department_id bigint [not null, note: "FK -> Department (catalogue), PROTECT."]
  head_id bigint [null, note: "nullable FK -> Employee, PROTECT. The employee who administers permissions for everyone in this department."]
  description text [not null, note: "TextField, blank."]
  status varchar [not null, note: "active/inactive."]
  opened_on date [null, note: "nullable DateField."]
  closed_on date [null, note: "nullable DateField."]
  Note: "CompanyDepartment | Direct company ownership. Constraints: unique `(branch, department)` — a branch adopts each catalogue department at most once; the branch must belong to the same company."
}

Table organization_company_designation {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  company_department_id bigint [not null, note: "FK -> CompanyDepartment, PROTECT."]
  designation_id bigint [not null, note: "FK -> Designation (catalogue), PROTECT."]
  status varchar [not null, note: "active/inactive."]
  Note: "CompanyDesignation | Direct company ownership. Constraints: unique `(company_department, designation)`. Any active designation may be placed under any of the company's departments; a designation root has deactivated cannot be newly placed, but existing placements keep it."
}

Table employees_employee {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  public_id uuid [not null, unique, note: "UUIDField, unique immutable external identifier."]
  user_id bigint [null, note: "nullable FK -> User, PROTECT."]
  first_name varchar [not null, note: "CharField."]
  middle_name varchar [not null, note: "CharField."]
  last_name varchar [not null, note: "CharField."]
  preferred_name varchar [not null, note: "CharField."]
  work_email varchar [null, note: "optional contacts."]
  personal_email varchar [null, note: "optional contacts."]
  phone varchar [null, note: "optional contacts."]
  date_of_birth date [null, note: "nullable DateField."]
  gender varchar [null, note: "optional controlled fields."]
  blood_group varchar [null, note: "optional controlled fields."]
  marital_status varchar [null, note: "optional controlled fields."]
  national_id varchar [null, note: "optional protected identifiers."]
  passport_number varchar [null, note: "optional protected identifiers."]
  address text [null, note: "optional fields."]
  emergency_contact_name varchar [null, note: "optional fields."]
  emergency_contact_phone varchar [null, note: "optional fields."]
  emergency_contact_relation varchar [null, note: "optional fields."]
  joining_date date [null, note: "nullable DateField as applicable."]
  confirmation_date date [null, note: "nullable DateField as applicable."]
  leaving_date date [null, note: "nullable DateField as applicable."]
  employment_status varchar [not null, note: "applicant, active, probation, suspended, resigned, terminated, retired."]
  photo varchar [null, note: "optional private ImageField."]
  metadata jsonb [not null, note: "JSONField for validated company-specific non-core attributes."]
  Note: "Employee | Direct company ownership. Constraints: unique `(company, user)` when user is not null. All business history references this permanent identity."
}

Table employees_employee_assignment {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  employee_id bigint [not null, note: "FK -> Employee, PROTECT."]
  employee_code varchar [not null, note: "CharField; manually entered reusable business code."]
  branch_id bigint [not null, note: "FK -> Branch, PROTECT."]
  department_id bigint [not null, note: "FK -> CompanyDepartment, PROTECT. The company's adoption row, never the catalogue row."]
  designation_id bigint [not null, note: "FK -> CompanyDesignation, PROTECT."]
  manager_id bigint [null, note: "nullable FK -> Employee, PROTECT."]
  effective_from timestamptz [not null, note: "DateTimeField."]
  effective_to timestamptz [null, note: "nullable DateTimeField."]
  change_reason text [not null, note: "TextField."]
  status varchar [not null, note: "active/ended/cancelled."]
  device_attendance_scope_override varchar [null, note: "nullable CharField: assigned_devices, department_devices, branch_devices, company_devices; null inherits the assigned branch/company policy. This employee-level override lives on dated assignment history; changing it closes the old interval and creates its successor."]
  Note: "EmployeeAssignment | Direct company ownership. Constraints: the company department belongs to the assignment's branch; the designation is one the company has placed under that department (a CompanyDesignation of it); manager is not the employee; no overlapping active periods for one employee; no overlapping occupancy of `(company, employee_code)`. The same code may be reused after the earlier interval ends."
}

Table employees_employee_compensation {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  employee_id bigint [not null, note: "FK -> Employee, PROTECT."]
  pay_basis varchar [not null, note: "monthly, daily, hourly."]
  base_rate numeric(18,2) [not null, note: "DecimalField money."]
  currency varchar(3) [not null, note: "CharField(3)."]
  overtime_rate_override numeric(18,2) [null, note: "nullable DecimalField money per hour."]
  effective_from timestamptz [not null, note: "DateTimeField."]
  effective_to timestamptz [null, note: "nullable DateTimeField."]
  reason text [not null, note: "TextField."]
  status varchar [not null, note: "draft, active, ended, cancelled."]
  Note: "EmployeeCompensation | Direct company ownership. Constraints: positive base rate; currency matches company policy; non-overlapping active compensation ranges per employee."
}

Table access_control_access_permission {
  id bigint [pk, increment, not null, note: "BigAutoField, PK."]
  feature_id bigint [not null, note: "FK -> Feature, PROTECT."]
  code varchar [not null, unique, note: "CharField, globally unique, e.g. `leave.approve`."]
  name varchar [not null, note: "display fields."]
  description text [not null, note: "display fields."]
  action varchar [not null, note: "view, create, edit, approve, finalize, pay, manage."]
  is_sensitive boolean [not null, note: "BooleanField for payroll/biometric actions."]
  is_active boolean [not null, note: "BooleanField."]
  created_at timestamptz [not null, note: "timestamps."]
  updated_at timestamptz [not null, note: "timestamps."]
  Note: "AccessPermission | Global/platform scope; AuditLog company is optional. "
}

Table access_control_designation_permission {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  designation_id bigint [not null, note: "FK -> CompanyDesignation, PROTECT."]
  permission_id bigint [not null, note: "FK -> AccessPermission, PROTECT."]
  access_level varchar [not null, note: "default, allowed, denied."]
  can_delegate boolean [not null, note: "BooleanField."]
  effective_from timestamptz [null, note: "nullable DateTimeField."]
  effective_to timestamptz [null, note: "nullable DateTimeField."]
  reason text [not null, note: "TextField."]
  Note: "DesignationPermission | Direct company ownership. Constraints: unique effective rule per designation/permission at any instant; a title may not be ALLOWED what its own department DENIES through DepartmentPermission (86). That department ceiling replaced the old designation parent-chain walk."
}

Table access_control_employee_permission_override {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  employee_id bigint [not null, note: "FK -> Employee, PROTECT."]
  permission_id bigint [not null, note: "FK -> AccessPermission, PROTECT."]
  effect varchar [not null, note: "grant/revoke."]
  effective_from timestamptz [null, note: "nullable DateTimeField."]
  effective_to timestamptz [null, note: "nullable DateTimeField."]
  granted_by_id bigint [not null, note: "FK -> User, PROTECT."]
  reason text [not null, note: "TextField."]
  status varchar [not null, note: "active/revoked/expired."]
  Note: "EmployeePermissionOverride | Direct company ownership. Constraints: a GRANT may not exceed what the employee's current department DENIES — this is what makes delegating to a department head safe, since the head cannot widen the boundary they administer inside; selected departments belong to selected branches/company."
}

Table access_control_department_permission {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  company_department_id bigint [not null, note: "FK -> CompanyDepartment, PROTECT."]
  permission_id bigint [not null, note: "FK -> AccessPermission, PROTECT."]
  access_level varchar [not null, note: "default, allowed, denied."]
  can_delegate boolean [not null, note: "BooleanField; whether the department head may pass this on."]
  effective_from timestamptz [null, note: "nullable DateTimeField."]
  effective_to timestamptz [null, note: "nullable DateTimeField."]
  reason text [not null, note: "TextField."]
  Note: "DepartmentPermission | Direct company ownership. Constraints: one effective rule per department/permission at any instant; end after start."
}

Table scheduling_shift {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  code varchar [not null, note: "CharField."]
  name varchar [not null, note: "CharField."]
  start_time time [not null, note: "TimeField."]
  end_time time [not null, note: "TimeField."]
  spans_next_day boolean [not null, note: "BooleanField."]
  scheduled_minutes integer [not null, note: "PositiveIntegerField; validated against times and breaks or calculated snapshot."]
  grace_in_minutes integer [not null, note: "PositiveIntegerField."]
  grace_out_minutes integer [not null, note: "PositiveIntegerField."]
  minimum_full_day_minutes integer [not null, note: "PositiveIntegerField."]
  minimum_half_day_minutes integer [not null, note: "PositiveIntegerField."]
  default_break_minutes integer [not null, note: "PositiveIntegerField."]
  break_is_paid boolean [not null, note: "BooleanField."]
  overtime_after_minutes integer [not null, note: "PositiveIntegerField after scheduled end."]
  effective_from date [null, note: "nullable DateField."]
  effective_to date [null, note: "nullable DateField."]
  status varchar [not null, note: "active/inactive."]
  Note: "Shift | Direct company ownership. Constraints: unique `(company, code)`; timing and minute thresholds must be internally consistent."
}

Table scheduling_department_shift {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  department_id bigint [not null, note: "FK -> CompanyDepartment, PROTECT."]
  shift_id bigint [not null, note: "FK -> Shift, PROTECT."]
  is_default boolean [not null, note: "BooleanField."]
  effective_from date [not null, note: "DateField."]
  effective_to date [null, note: "nullable DateField."]
  status varchar [not null, note: "active/ended."]
  Note: "DepartmentShift | Direct company ownership. Constraints: no overlapping duplicate department/shift assignments; at most one default at a time. In single-shift company mode all active department shifts must reference the company shift."
}

Table scheduling_employee_shift_assignment {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  employee_id bigint [not null, note: "FK -> Employee, PROTECT."]
  shift_id bigint [not null, note: "FK -> Shift, PROTECT."]
  effective_from timestamptz [not null, note: "DateTimeField."]
  effective_to timestamptz [null, note: "nullable DateTimeField."]
  assignment_type varchar [not null, note: "department_selection, employee_override, temporary."]
  reason text [not null, note: "TextField."]
  assigned_by_id bigint [not null, note: "FK -> User, PROTECT."]
  status varchar [not null, note: "active/ended/cancelled."]
  Note: "EmployeeShiftAssignment | Direct company ownership. Constraints: no overlapping effective assignments for an employee. Validate department eligibility except for an authorized override."
}

Table scheduling_company_attendance_settings {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, unique, note: "O2O -> Company, PROTECT, primary tenant owner."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  shift_mode varchar [not null, note: "company_single_shift or department_shifts."]
  company_shift_id bigint [null, note: "nullable FK -> Shift, PROTECT."]
  punch_pairing_strategy varchar [not null, note: "alternating initially."]
  device_attendance_scope varchar [not null, note: "CharField: assigned_devices, department_devices, branch_devices, company_devices; default assigned_devices. Effective precedence: EmployeeAssignment override, assigned Branch override, company setting."]
  duplicate_punch_window_seconds integer [not null, note: "PositiveIntegerField."]
  attendance_window_before_minutes integer [not null, note: "PositiveIntegerField."]
  attendance_window_after_minutes integer [not null, note: "PositiveIntegerField."]
  missing_punch_policy varchar [not null, note: "review_required by default."]
  overtime_requires_approval boolean [not null, note: "BooleanField."]
  round_work_minutes_to integer [not null, note: "PositiveIntegerField."]
  round_overtime_minutes_to integer [not null, note: "PositiveIntegerField."]
  settings_version integer [not null, note: "PositiveIntegerField."]
  effective_from timestamptz [not null, note: "DateTimeField."]
  Note: "CompanyAttendanceSettings | Direct company ownership. Constraint: company_shift required only in single-shift mode. Historical AttendanceRecord snapshots preserve rules actually used."
}

Table scheduling_weekly_off_rule {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  branch_id bigint [null, note: "nullable FK -> Branch, PROTECT; null means company-wide."]
  weekday integer [not null, note: "choices 0–6."]
  is_paid boolean [not null, note: "BooleanField."]
  effective_from date [not null, note: "DateField."]
  effective_to date [null, note: "nullable DateField."]
  status varchar [not null, note: "active/ended."]
  Note: "WeeklyOffRule | Direct company ownership. Constraints: prevent overlapping duplicate weekday rules for the same company/branch."
}

Table scheduling_holiday {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  branch_id bigint [null, note: "nullable FK -> Branch, PROTECT; null means company-wide."]
  holiday_date date [not null, note: "DateField."]
  name text [not null, note: "text fields."]
  description text [not null, note: "text fields."]
  is_paid boolean [not null, note: "BooleanField."]
  status varchar [not null, note: "active/cancelled."]
  cancelled_at timestamptz [null, note: "nullable timestamp/FK -> User."]
  cancelled_by_id bigint [null, note: "nullable timestamp/FK -> User."]
  Note: "Holiday | Direct company ownership. Constraints: unique active holiday per `(company, branch, holiday_date)`, treating null branch as a comparable company-wide scope."
}

Table scheduling_holiday_work_assignment {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  employee_id bigint [not null, note: "FK -> Employee, PROTECT."]
  work_date date [not null, note: "DateField."]
  holiday_id bigint [null, note: "nullable FK -> Holiday, PROTECT."]
  weekly_off_rule_id bigint [null, note: "nullable FK -> WeeklyOffRule, PROTECT."]
  shift_id bigint [null, note: "nullable FK -> Shift, PROTECT."]
  treatment varchar [not null, note: "normal_workday, overtime, compensatory_leave, overtime_and_comp_leave when explicitly allowed."]
  reason text [not null, note: "TextField."]
  approved_by_id bigint [not null, note: "FK -> User and DateTimeField."]
  approved_at timestamptz [not null, note: "FK -> User and DateTimeField."]
  status varchar [not null, note: "draft, approved, cancelled."]
  Note: "HolidayWorkAssignment | Direct company ownership. Constraints: exactly one applicable source (dated holiday or recurring weekly-off rule); source applies on work_date; one active assignment per employee/work_date/source."
}

Table devices_device_vendor {
  id bigint [pk, increment, not null, note: "BigAutoField, PK."]
  code varchar [not null, unique, note: "unique identifiers/display name."]
  name varchar [not null, unique, note: "unique identifiers/display name."]
  adapter_key varchar [not null, note: "CharField selecting a reviewed application adapter, never executable user input."]
  description text [null, note: "optional fields."]
  support_url varchar [null, note: "optional fields."]
  is_active boolean [not null, note: "BooleanField."]
  created_at timestamptz [not null, note: "timestamps."]
  updated_at timestamptz [not null, note: "timestamps."]
  Note: "DeviceVendor | Global/platform scope; AuditLog company is optional. Relations: DeviceModel and optional BiometricTemplate format metadata."
}

Table devices_device_model {
  id bigint [pk, increment, not null, note: "BigAutoField, PK."]
  vendor_id bigint [not null, note: "FK -> DeviceVendor, PROTECT."]
  model_code varchar [not null, note: "CharField."]
  name varchar [not null, note: "CharField."]
  protocol varchar [not null, note: "adms_push, webhook, vendor_cloud_api, file_import, other."]
  capabilities jsonb [not null, note: "JSONField, validated flags for push, face, fingerprint, card, commands, template export/import."]
  supported_template_formats jsonb [not null, note: "JSONField list of stable format/version codes."]
  is_active boolean [not null, note: "BooleanField."]
  created_at timestamptz [not null, note: "timestamps."]
  updated_at timestamptz [not null, note: "timestamps."]
  Note: "DeviceModel | Global/platform scope; AuditLog company is optional. Constraint: unique `(vendor, model_code)`."
}

Table devices_biometric_device {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  public_id uuid [not null, unique, note: "UUIDField, unique."]
  branch_id bigint [not null, note: "FK -> Branch, PROTECT."]
  device_model_id bigint [not null, note: "FK -> DeviceModel, PROTECT."]
  name varchar [not null, note: "CharField."]
  serial_number varchar [not null, note: "CharField."]
  external_device_id varchar [null, note: "optional CharField used by vendor/cloud."]
  timezone varchar [not null, note: "CharField."]
  authentication_key_id varchar [not null, note: "CharField identifying a server-managed secret."]
  authentication_secret_hash varchar [not null, note: "password/hash field; never return the secret after enrollment."]
  firmware_version varchar [null, note: "optional diagnostic fields."]
  ip_address_last_seen inet [null, note: "optional diagnostic fields."]
  installed_at timestamptz [null, note: "nullable DateTimeField."]
  decommissioned_at timestamptz [null, note: "nullable DateTimeField."]
  last_seen_at timestamptz [null, note: "nullable DateTimeField."]
  last_message_at timestamptz [null, note: "nullable DateTimeField."]
  clock_offset_seconds integer [null, note: "nullable IntegerField diagnostic estimate."]
  settings jsonb [not null, note: "validated JSONField for vendor-specific configuration."]
  status varchar [not null, note: "pending, active, offline, suspended, retired."]
  Note: "BiometricDevice | Direct company ownership. Constraints: unique `(company, serial_number)`; device branch belongs to company."
}

Table devices_device_department {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  device_id bigint [not null, note: "FK -> BiometricDevice, PROTECT."]
  department_id bigint [not null, note: "FK -> CompanyDepartment, PROTECT. Not the catalogue row: a device belongs to one company's department in one branch."]
  effective_from timestamptz [not null, note: "DateTimeField."]
  effective_to timestamptz [null, note: "nullable DateTimeField."]
  status varchar [not null, note: "active/ended."]
  Note: "DeviceDepartment | Direct company ownership. Constraints: device and department have the same company and branch; no overlapping duplicate mapping. This is the explicit through table for `BiometricDevice.departments`. Active mappings restrict department_devices mode; no active mappings means a shared branch device in that mode. These mappings do not additionally restrict branch_devices/company_devices mode or an explicit assigned-device grant."
}

Table devices_device_enrollment {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  device_id bigint [not null, note: "FK -> BiometricDevice, PROTECT."]
  employee_id bigint [not null, note: "FK -> Employee, PROTECT."]
  device_user_id varchar [not null, note: "CharField exactly as stored by the device."]
  card_number varchar [null, note: "optional encrypted/masked CharField."]
  device_privilege varchar [not null, note: "normal_user, device_admin, other."]
  attendance_enabled boolean [not null, note: "BooleanField, default true; a per-enrollment master switch. False excludes punches under every device scope, even company_devices. Evaluate historical value at punch time."]
  assigned_device_authorized boolean [not null, note: "BooleanField, default false; explicit permission for assigned_devices mode. Wider department/branch/company scopes do not require this flag. Creating an enrollment for recognition alone does not grant restricted-mode attendance permission."]
  effective_from timestamptz [not null, note: "DateTimeField."]
  effective_to timestamptz [null, note: "nullable DateTimeField."]
  enrollment_status varchar [not null, note: "pending, queued, synced, failed, removed."]
  vendor_enrollment_revision varchar [null, note: "optional CharField."]
  last_synced_at timestamptz [null, note: "nullable DateTimeField."]
  removed_at timestamptz [null, note: "nullable DateTimeField."]
  sync_error_code varchar [null, note: "optional fields."]
  sync_error_message text [null, note: "optional fields."]
  Note: "DeviceEnrollment | Direct company ownership. Constraints: no overlapping use of one `(device, device_user_id)`; no overlapping duplicate employee/device authorization; resolve historical mapping using the punch timestamp. Enrollment identity, master enablement, and explicit assigned-device grant are separate concerns. Keep historical authorization changes in the audit trail; see DEVICE_ATTENDANCE_POLICY.md."
}

Table devices_biometric_template {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  employee_id bigint [not null, note: "FK -> Employee, PROTECT."]
  biometric_type varchar [not null, note: "fingerprint or face."]
  finger_position varchar [null, note: "nullable choice for fingerprint."]
  template_format varchar [not null, note: "CharField."]
  template_version varchar [not null, note: "CharField."]
  vendor_id bigint [null, note: "nullable FK -> DeviceVendor, PROTECT."]
  compatible_device_model_id bigint [null, note: "nullable FK -> DeviceModel, PROTECT."]
  captured_from_device_id bigint [null, note: "nullable FK -> BiometricDevice, SET_NULL."]
  encrypted_template_data bytea [not null, note: "BinaryField containing application-encrypted bytes."]
  encryption_key_version varchar [not null, note: "CharField."]
  template_checksum varchar [not null, note: "CharField."]
  template_size_bytes integer [null, note: "nullable integers."]
  quality_score integer [null, note: "nullable integers."]
  captured_at timestamptz [not null, note: "DateTimeField."]
  status varchar [not null, note: "active, revoked, incompatible, deleted_pending."]
  revoked_at timestamptz [null, note: "nullable audit fields."]
  revoked_by_id bigint [null, note: "nullable audit fields."]
  revocation_reason text [null, note: "nullable audit fields."]
  Note: "BiometricTemplate | Direct company ownership. Constraints: checksum/employee/type/format duplicate detection; face has no finger_position. Database backups and application logs must protect the encrypted data and key references."
}

Table devices_device_enrollment_template {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  device_enrollment_id bigint [not null, note: "FK -> DeviceEnrollment, PROTECT."]
  biometric_template_id bigint [not null, note: "FK -> BiometricTemplate, PROTECT."]
  device_template_id varchar [null, note: "optional vendor-side identifier."]
  deployment_status varchar [not null, note: "pending, queued, synced, failed, removed."]
  attempt_count integer [not null, note: "PositiveIntegerField."]
  last_attempt_at timestamptz [null, note: "nullable DateTimeField."]
  deployed_at timestamptz [null, note: "nullable DateTimeField."]
  removed_at timestamptz [null, note: "nullable DateTimeField."]
  last_error_code varchar [null, note: "optional fields."]
  last_error_message text [null, note: "optional fields."]
  source_key varchar [not null, note: "CharField idempotency key."]
  Note: "DeviceEnrollmentTemplate | Direct company ownership. Constraints: unique active `(device_enrollment, biometric_template)`; employee and compatibility must match enrollment/device."
}

Table devices_device_sync_state {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  device_id bigint [not null, unique, note: "O2O -> BiometricDevice, PROTECT."]
  last_vendor_sequence varchar [null, note: "optional CharField."]
  last_vendor_cursor varchar [null, note: "optional CharField."]
  last_device_event_at timestamptz [null, note: "nullable DateTimeField."]
  last_message_received_at timestamptz [null, note: "nullable DateTimeField."]
  last_punch_received_at timestamptz [null, note: "nullable DateTimeField."]
  last_success_at timestamptz [null, note: "nullable DateTimeField."]
  last_error_at timestamptz [null, note: "nullable DateTimeField."]
  last_error_code varchar [null, note: "optional fields."]
  last_error_message text [null, note: "optional fields."]
  consecutive_error_count integer [not null, note: "PositiveIntegerField."]
  estimated_backlog_count integer [not null, note: "PositiveIntegerField."]
  clock_offset_seconds integer [null, note: "nullable IntegerField."]
  state_data jsonb [not null, note: "validated JSONField for adapter-specific cursors."]
  version bigint [not null, note: "PositiveBigIntegerField for concurrency control."]
  Note: "DeviceSyncState | Direct company ownership. "
}

Table devices_device_message {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  public_id uuid [not null, unique, note: "UUIDField, unique."]
  device_id bigint [not null, note: "FK -> BiometricDevice, PROTECT."]
  branch_id bigint [not null, note: "FK -> Branch, PROTECT snapshot at receipt."]
  message_type varchar [not null, note: "punch_batch, heartbeat, enrollment_result, command_result, device_info, unknown."]
  vendor_message_id varchar [null, note: "nullable CharField."]
  vendor_sequence varchar [null, note: "nullable CharField."]
  idempotency_key varchar [null, note: "nullable CharField; set only from a trustworthy adapter identity."]
  occurred_at_device timestamptz [null, note: "nullable DateTimeField retaining the interpreted device time."]
  received_at timestamptz [not null, note: "DateTimeField, indexed."]
  content_type varchar [not null, note: "CharField."]
  encoding varchar [not null, note: "CharField."]
  raw_payload_text text [null, note: "nullable TextField."]
  raw_payload_binary bytea [null, note: "nullable BinaryField/private object reference for large payloads."]
  payload_json jsonb [null, note: "nullable JSONField parsed envelope."]
  payload_hash varchar [not null, note: "CharField checksum."]
  source_ip inet [null, note: "optional protected diagnostic fields."]
  request_headers_snapshot jsonb [null, note: "optional protected diagnostic fields."]
  record_count integer [null, note: "nullable PositiveIntegerField."]
  processing_status varchar [not null, note: "received, parsing, parsed, partially_failed, failed."]
  processing_started_at timestamptz [null, note: "nullable DateTimeField."]
  processed_at timestamptz [null, note: "nullable DateTimeField."]
  processing_attempts integer [not null, note: "PositiveIntegerField."]
  processing_error text [not null, note: "TextField."]
  Note: "DeviceMessage | Direct company ownership. Constraints: one raw representation must exist; reliable `(device, idempotency_key)` unique when non-null. A payload hash alone is not safe proof that two punches are identical."
}

Table devices_punch_event {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  device_message_id bigint [not null, note: "FK -> DeviceMessage, PROTECT."]
  device_id bigint [not null, note: "FK -> BiometricDevice/Branch, PROTECT snapshots."]
  branch_id bigint [not null, note: "FK -> BiometricDevice/Branch, PROTECT snapshots."]
  device_enrollment_id bigint [null, note: "nullable FK -> DeviceEnrollment, PROTECT."]
  employee_id bigint [null, note: "nullable FK -> Employee, PROTECT."]
  device_user_id varchar [not null, note: "CharField received from device."]
  vendor_punch_id varchar [null, note: "nullable CharField."]
  vendor_sequence varchar [null, note: "nullable CharField."]
  source_record_index integer [not null, note: "PositiveIntegerField within the message."]
  punched_at_device_raw varchar [not null, note: "CharField preserving original representation."]
  punched_at_device timestamptz [not null, note: "parsed DateTimeField."]
  punched_at_utc timestamptz [not null, note: "parsed DateTimeField."]
  device_timezone varchar [not null, note: "snapshot fields."]
  utc_offset_minutes integer [not null, note: "snapshot fields."]
  received_at timestamptz [not null, note: "DateTimeField."]
  verification_method varchar [not null, note: "fingerprint, face, card, PIN, unknown."]
  reported_direction varchar [null, note: "nullable vendor value; informational because it is not trusted."]
  reported_status_code varchar [null, note: "nullable CharField."]
  raw_record jsonb [not null, note: "JSONField/text snapshot of the individual source record."]
  authorization_status varchar [not null, note: "authorized, unauthorized_device, unknown_employee, expired_enrollment, department_mismatch, branch_mismatch, enrollment_disabled, policy_unresolved."]
  authorization_snapshot jsonb [not null, note: "JSONField containing the effective scope, winning policy level, effective evaluation time, historical enablement/grant results, and decision reason. These are frozen evaluation facts, not authoritative live relationships. Update resolution metadata only with an audited revision; never rewrite raw source values."]
  dedupe_status varchar [not null, unique, note: "unique, probable_duplicate, confirmed_duplicate."]
  duplicate_of_id bigint [null, note: "nullable FK -> self, PROTECT."]
  processing_status varchar [not null, note: "pending, allocated, excluded, needs_review, failed."]
  processing_error text [not null, note: "TextField."]
  resolved_at timestamptz [null, note: "nullable DateTimeField."]
  processed_at timestamptz [null, note: "nullable DateTimeField."]
  Note: "PunchEvent | Direct company ownership. Constraints: unique `(device_message, source_record_index)`; reliable vendor punch identity unique per device when present. Timestamp is never the sole unique key."
}

Table payroll_punch_allocation {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  attendance_record_id bigint [not null, note: "FK -> AttendanceRecord, PROTECT."]
  punch_event_id bigint [null, note: "nullable FK -> PunchEvent, PROTECT."]
  attendance_correction_id bigint [null, note: "nullable FK -> AttendanceCorrection, PROTECT for approved manual input."]
  sequence_number integer [not null, note: "PositiveIntegerField."]
  event_at timestamptz [not null, note: "DateTimeField used by calculation; copied from punch or approved correction."]
  interpreted_direction varchar [not null, note: "in, out, ignored, unresolved."]
  is_included boolean [not null, note: "BooleanField."]
  exclusion_reason text [not null, note: "duplicate, unauthorized_device, outside_window, superseded, manual_exclusion, other."]
  confidence numeric(18,6) [null, note: "nullable DecimalField."]
  calculation_version integer [not null, note: "PositiveIntegerField."]
  interpretation_note text [not null, note: "TextField."]
  Note: "PunchAllocation | Direct company ownership. Constraints: exactly one source (PunchEvent or approved AttendanceCorrection); unique source per calculation version; sequence unique within attendance/version. Merge all authorized devices into one employee/shift stream ordered by event time; never restart alternating IN/OUT at each device or incoming batch."
}

Table payroll_attendance_session {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  attendance_record_id bigint [not null, note: "FK -> AttendanceRecord, PROTECT."]
  sequence_number integer [not null, note: "PositiveIntegerField."]
  in_allocation_id bigint [null, unique, note: "nullable O2O/FK -> PunchAllocation, PROTECT."]
  out_allocation_id bigint [null, unique, note: "nullable O2O/FK -> PunchAllocation, PROTECT."]
  started_at timestamptz [null, note: "nullable DateTimeField."]
  ended_at timestamptz [null, note: "nullable DateTimeField."]
  worked_minutes integer [not null, note: "PositiveIntegerField."]
  status varchar [not null, note: "complete, missing_in, missing_out, invalid."]
  is_manual boolean [not null, note: "BooleanField."]
  calculation_version integer [not null, note: "PositiveIntegerField."]
  Note: "AttendanceSession | Direct company ownership. Constraints: end after start; allocation directions correct; sequence unique per record/version. Both allocations belong to this attendance record and employee/company, but may originate from different devices. Never require matching device IDs."
}

Table payroll_attendance_record {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  employee_id bigint [not null, note: "FK -> Employee, PROTECT."]
  employee_assignment_id bigint [not null, note: "FK -> EmployeeAssignment, PROTECT."]
  branch_id bigint [not null, note: "FK -> Branch/Department, PROTECT historical snapshots."]
  department_id bigint [not null, note: "FK -> Branch/Department, PROTECT historical snapshots."]
  work_date date [not null, note: "DateField."]
  shift_id bigint [not null, note: "FK -> Shift, PROTECT."]
  shift_snapshot jsonb [not null, note: "JSONField."]
  attendance_settings_snapshot jsonb [not null, note: "JSONField."]
  scheduled_start_at timestamptz [not null, note: "DateTimeField."]
  scheduled_end_at timestamptz [not null, note: "DateTimeField."]
