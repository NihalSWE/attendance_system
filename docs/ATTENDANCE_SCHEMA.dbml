  currency varchar(3) [not null, note: "CharField(3)."]
  status varchar [not null, note: "draft, open, processing, closed, locked, cancelled."]
  opened_by_id bigint [null, note: "nullable FK -> User/DateTimeField."]
  opened_at timestamptz [null, note: "nullable FK -> User/DateTimeField."]
  closed_by_id bigint [null, note: "nullable FK -> User/DateTimeField."]
