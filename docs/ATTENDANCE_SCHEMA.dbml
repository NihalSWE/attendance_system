  leave_encashment_id bigint [null, note: "nullable FK -> LeaveEncashment, PROTECT."]
  lfa_claim_id bigint [null, note: "nullable FK -> LeaveFareAssistanceClaim, PROTECT."]
  description text [not null, note: "CharField."]
  service_date date [null, note: "nullable DateField."]
  service_period_start date [null, note: "nullable DateField."]
  service_period_end date [null, note: "nullable DateField."]
  quantity numeric(18,6) [null, note: "nullable DecimalField."]
  rate numeric(18,6) [null, note: "nullable DecimalField."]
  percentage numeric(18,6) [null, note: "nullable DecimalField."]
  amount numeric(18,2) [not null, note: "nonnegative DecimalField money."]
  direction varchar [not null, note: "earning, deduction, employer_only."]
  currency varchar(3) [not null, note: "CharField(3)."]
  formula_snapshot jsonb [not null, note: "JSONField."]
  calculation_details jsonb [not null, note: "JSONField."]
  taxable boolean [not null, note: "BooleanField."]
  is_manual boolean [not null, note: "BooleanField."]
  is_system_generated boolean [not null, note: "BooleanField."]
  original_line_id bigint [null, note: "nullable FK -> self, PROTECT for reversals/corrections."]
  status varchar [not null, note: "active, void, reversed."]
  Note: "PayrollLine | Direct company ownership. Constraints: source fields must agree with `source_type`; at most one typed source for a normal line; prevent duplicate active posting from the same source/component/run; reversal lines reference an original and use the opposite financial effect."
}

