  leave_cutoff_at timestamptz [not null, note: "DateTimeField."]
  adjustment_cutoff_at timestamptz [not null, note: "DateTimeField."]
  idempotency_key varchar [not null, note: "CharField."]
  status varchar [not null, note: "draft, queued, calculating, review, approved, posted, failed, cancelled, reversed."]
  calculation_started_at timestamptz [null, note: "nullable DateTimeField."]
  calculation_finished_at timestamptz [null, note: "nullable DateTimeField."]
  generated_by_id bigint [null, note: "nullable FK -> User, SET_NULL/PROTECT according to audit policy."]
  approved_by_id bigint [null, note: "nullable FK -> User, SET_NULL/PROTECT according to audit policy."]
  posted_by_id bigint [null, note: "nullable FK -> User, SET_NULL/PROTECT according to audit policy."]
  approved_at timestamptz [null, note: "nullable DateTimeField."]
  posted_at timestamptz [null, note: "nullable DateTimeField."]
  failure_code varchar [not null, note: "blank CharField/TextField."]
  failure_message text [not null, note: "blank CharField/TextField."]
  totals_snapshot jsonb [not null, note: "JSONField."]
  Note: "PayrollRun | Direct company ownership. Constraints: unique `(company, idempotency_key)` and `(payroll_period, run_type, revision_number)`; only one posted regular result chain may be authoritative for an employee/period."
}

Table payroll_payrollrecord {
