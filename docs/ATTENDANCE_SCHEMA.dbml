Table payroll_settings {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, unique, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  currency varchar(3) [not null, note: "CharField(3), default company currency."]
  pay_frequency varchar [not null, note: "monthly initially; reserved choices may include weekly, biweekly, semimonthly."]
  period_start_day integer [not null, note: "PositiveSmallIntegerField, normally 1."]
  default_pay_day integer [null, note: "nullable PositiveSmallIntegerField."]
  default_policy_version_id bigint [null, note: "nullable FK -> PayrollPolicyVersion, PROTECT."]
  default_salary_structure_id bigint [null, note: "nullable FK -> SalaryStructure, PROTECT."]
  monthly_divisor numeric(18,6) [not null, note: "DecimalField, default 30 for the agreed initial deduction basis."]
  overtime_enabled boolean [not null, note: "BooleanField."]
  bonus_enabled boolean [not null, note: "BooleanField."]
  advances_enabled boolean [not null, note: "BooleanField."]
  loans_enabled boolean [not null, note: "BooleanField."]
  auto_include_approved_overtime boolean [not null, note: "BooleanField."]
  auto_include_approved_leave boolean [not null, note: "BooleanField, normally true."]
  require_payroll_approval boolean [not null, note: "BooleanField."]
  allow_negative_net_pay boolean [not null, note: "BooleanField, normally false."]
  default_payment_method varchar [null, note: "nullable CharField."]
  settings_version integer [not null, note: "PositiveIntegerField for optimistic concurrency/display."]
  Note: "PayrollSettings | Direct company ownership. Constraint: unique `company` (implement as O2O semantics)."
}

Table payroll_policy_version {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  name varchar [not null, note: "CharField."]
  code varchar [not null, note: "CharField."]
  version_number integer [not null, note: "PositiveIntegerField."]
  effective_from date [not null, note: "DateField range."]
  effective_to date [null, note: "DateField range."]
  monthly_divisor numeric(18,6) [not null, note: "DecimalField, default 30."]
  monthly_proration_method varchar [not null, note: "fixed_30, calendar_days, scheduled_workdays, none."]
  daily_rate_method varchar [not null, note: "explicit_rate, monthly_divisor, scheduled_workdays."]
  hourly_rate_method varchar [not null, note: "explicit_rate, daily_scheduled_hours, monthly_standard_hours."]
  joining_leaving_proration_method varchar [not null, note: "CharField controlled choice."]
  absence_deduction_method varchar [not null, note: "day_fraction, scheduled_minutes, rule_only."]
  paid_leave_treatment varchar [not null, note: "controlled choices/DecimalField defaults."]
  partial_leave_treatment varchar [not null, note: "controlled choices/DecimalField defaults."]
  unpaid_leave_treatment varchar [not null, note: "controlled choices/DecimalField defaults."]
  overtime_method varchar [not null, note: "none, hourly_rate, fixed_rate, multiplier."]
  overtime_multiplier numeric(18,6) [not null, note: "DecimalField."]
  holiday_overtime_multiplier numeric(18,6) [not null, note: "DecimalField."]
  overtime_rounding_minutes integer [not null, note: "PositiveIntegerField."]
  minimum_overtime_minutes integer [not null, note: "PositiveIntegerField."]
  require_overtime_approval boolean [not null, note: "BooleanField."]
  late_penalty_stacking_method varchar [not null, note: "highest_only, cumulative, capped."]
  maximum_period_deduction_percent numeric(18,6) [null, note: "nullable DecimalField."]
  maximum_recovery_percent_of_net numeric(18,6) [null, note: "nullable DecimalField."]
  money_rounding_mode varchar [not null, note: "CharField/DecimalField."]
  money_rounding_increment numeric(18,6) [not null, note: "CharField/DecimalField."]
  allow_negative_net_pay boolean [not null, note: "BooleanField."]
  calculation_config jsonb [not null, note: "JSONField for validated non-relational formula parameters."]
  status varchar [not null, note: "draft, active, retired."]
  activated_by_id bigint [null, note: "nullable FK -> User/DateTimeField."]
  activated_at timestamptz [null, note: "nullable FK -> User/DateTimeField."]
  Note: "PayrollPolicyVersion | Direct company ownership. Constraints: unique `(company, code, version_number)`; no overlapping active date ranges for the same code; activated versions are immutable."
}

Table payroll_salary_component {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  code varchar [not null, note: "CharField."]
  name varchar [not null, note: "CharField."]
  category varchar [not null, note: "earning, deduction, reimbursement, employer_contribution."]
  subtype varchar [not null, note: "base_salary, overtime, bonus, allowance, absence, penalty, advance_recovery, loan_recovery, leave_encashment, lfa, tax, other."]
  calculation_method varchar [not null, note: "fixed, quantity_x_rate, percentage, formula, source_amount."]
  default_amount numeric(18,2) [null, note: "nullable DecimalField."]
  default_rate numeric(18,6) [null, note: "nullable DecimalField."]
  default_percentage numeric(18,6) [null, note: "nullable DecimalField."]
  formula_expression text [not null, note: "blank TextField; use a restricted expression language, never Python eval."]
  taxable boolean [not null, note: "BooleanField."]
  affects_gross boolean [not null, note: "BooleanField."]
  affects_net_pay boolean [not null, note: "BooleanField."]
  recurring boolean [not null, note: "BooleanField."]
  proratable boolean [not null, note: "BooleanField."]
  include_in_overtime_base boolean [not null, note: "BooleanField."]
  display_order integer [not null, note: "PositiveIntegerField."]
  external_code varchar [null, note: "optional CharField for accounting/payment integration."]
  is_active boolean [not null, note: "BooleanField."]
  Note: "SalaryComponent | Direct company ownership. Constraints: unique `(company, code)`; category and sign behavior must agree."
}

Table payroll_salary_structure {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
