}

Table payroll_loan_repayment_allocation {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  loan_repayment_id bigint [not null, note: "FK -> LoanRepayment, PROTECT."]
  loan_installment_id bigint [not null, note: "FK -> LoanInstallment, PROTECT."]
  principal_amount numeric(18,2) [not null, note: "nonnegative DecimalField money."]
  interest_amount numeric(18,2) [not null, note: "nonnegative DecimalField money."]
  fee_amount numeric(18,2) [not null, note: "nonnegative DecimalField money."]
  allocated_at timestamptz [not null, note: "DateTimeField."]
  status varchar [not null, note: "active, reversed."]
  reversal_of_id bigint [null, unique, note: "nullable O2O -> self, PROTECT."]
  Note: "LoanRepaymentAllocation | Direct company ownership. Constraints: repayment and installment belong to the same loan/company/currency; active allocations cannot exceed the repayment or remaining installment balances."
}

Table payroll_adjustment {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  employee_id bigint [not null, note: "FK -> Employee, PROTECT."]
  adjustment_reference varchar [not null, note: "CharField."]
  salary_component_id bigint [null, note: "nullable FK -> SalaryComponent, PROTECT."]
  target_payroll_period_id bigint [null, note: "nullable FK -> PayrollPeriod, PROTECT."]
  adjustment_type varchar [not null, note: "earning, deduction, correction, advance_waiver, loan_waiver, carry_forward."]
  amount numeric(18,2) [not null, note: "DecimalField money; store nonnegative and use type/direction for effect."]
  currency varchar(3) [not null, note: "CharField(3)."]
  service_date date [null, note: "nullable DateField."]
  reason text [not null, note: "TextField."]
  source_document_reference varchar [null, note: "optional CharField."]
  affects_payroll boolean [not null, note: "BooleanField."]
  affects_advance_balance boolean [not null, note: "BooleanField."]
  affects_loan_balance boolean [not null, note: "BooleanField."]
  salary_advance_id bigint [null, note: "nullable FK -> SalaryAdvance, PROTECT."]
  employee_loan_id bigint [null, note: "nullable FK -> EmployeeLoan, PROTECT."]
  status varchar [not null, note: "draft, submitted, approved, rejected, posted, cancelled, reversed."]
  approved_by_id bigint [null, note: "nullable FK -> User/DateTimeField."]
  approved_at timestamptz [null, note: "nullable FK -> User/DateTimeField."]
  posted_at timestamptz [null, note: "nullable FK -> User/DateTimeField."]
  idempotency_key varchar [not null, note: "CharField."]
  reversal_of_id bigint [null, unique, note: "nullable O2O -> self, PROTECT."]
  Note: "PayrollAdjustment | Direct company ownership. Constraints: unique `(company, adjustment_reference)` and `(company, idempotency_key)`; target/source fields agree with adjustment type; a balance-only waiver must not silently create salary earnings."
}

Table payroll_remittance {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  payroll_period_id bigint [not null, note: "FK -> PayrollPeriod, PROTECT."]
  provider_type varchar [not null, note: "tax_authority, insurer, lender, benefit_provider, other."]
  provider_name varchar [not null, note: "CharField."]
  provider_account_reference varchar [not null, note: "CharField."]
  remittance_reference varchar [not null, note: "CharField."]
  remittance_date date [null, note: "nullable DateField."]
  amount numeric(18,2) [not null, note: "positive DecimalField money."]
  currency varchar(3) [not null, note: "CharField(3)."]
  payment_method varchar [null, note: "optional CharField."]
  provider_transaction_reference varchar [null, note: "optional CharField."]
  status varchar [not null, note: "draft, approved, submitted, completed, failed, cancelled, reversed."]
  approved_by_id bigint [null, note: "nullable FK -> User, PROTECT."]
  processed_by_id bigint [null, note: "nullable FK -> User, PROTECT."]
  approved_at timestamptz [null, note: "nullable DateTimeField."]
  processed_at timestamptz [null, note: "nullable DateTimeField."]
  idempotency_key varchar [not null, note: "CharField."]
  reversal_of_id bigint [null, unique, note: "nullable O2O -> self, PROTECT."]
  Note: "PayrollRemittance | Direct company ownership. Constraints: unique `(company, remittance_reference)` and `(company, idempotency_key)`; active allocations cannot exceed a completed remittance."
}

Table payroll_remittance_allocation {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  payroll_remittance_id bigint [not null, note: "FK -> PayrollRemittance, PROTECT."]
  payroll_line_id bigint [not null, note: "FK -> PayrollLine, PROTECT."]
  allocated_amount numeric(18,2) [not null, note: "positive DecimalField money."]
  allocated_at timestamptz [not null, note: "DateTimeField."]
  status varchar [not null, note: "active, reversed."]
  reversal_of_id bigint [null, unique, note: "nullable O2O -> self, PROTECT."]
  Note: "PayrollRemittanceAllocation | Direct company ownership. Constraints: remittance and line must have the same company/currency/provider-compatible component; active allocations cannot exceed either available remittance value or line liability."
}

Table subscriptions_package {
  id bigint [pk, increment, not null, note: "BigAutoField, PK."]
  code varchar [not null, unique, note: "unique CharField."]
  name varchar [not null, unique, note: "unique CharField."]
  description text [not null, note: "TextField, blank."]
  billing_interval varchar [not null, note: "monthly, yearly, custom."]
  price numeric(18,2) [not null, note: "DecimalField money/CharField(3)."]
  currency varchar(3) [not null, note: "DecimalField money/CharField(3)."]
  included_employee_limit integer [null, note: "nullable PositiveIntegerField; null means unlimited."]
  included_user_limit integer [null, note: "nullable PositiveIntegerField if login-seat pricing is later offered."]
  device_limit integer [null, note: "nullable PositiveIntegerField."]
  branch_limit integer [null, note: "nullable PositiveIntegerField."]
  trial_days integer [not null, note: "PositiveIntegerField."]
  is_public boolean [not null, note: "BooleanField."]
  is_active boolean [not null, note: "BooleanField."]
  display_order integer [not null, note: "PositiveIntegerField."]
  created_by_id bigint [null, note: "nullable FK -> User, SET_NULL."]
  updated_by_id bigint [null, note: "nullable FK -> User, SET_NULL."]
  created_at timestamptz [not null, note: "DateTimeField."]
  updated_at timestamptz [not null, note: "DateTimeField."]
  Note: "Package | Global/platform scope; AuditLog company is optional. Relations: features are M2M -> Feature through PackageFeature; CompanySubscription references Package."
}

Table subscriptions_package_feature {
  id bigint [pk, increment, not null, note: "BigAutoField, PK."]
  package_id bigint [not null, note: "FK -> Package, CASCADE."]
  feature_id bigint [not null, note: "FK -> Feature, PROTECT."]
  is_included boolean [not null, note: "BooleanField."]
  usage_limit bigint [null, note: "nullable PositiveBigIntegerField."]
  configuration jsonb [not null, note: "JSONField for validated feature-specific commercial limits."]
  created_at timestamptz [not null, note: "DateTimeField."]
  updated_at timestamptz [not null, note: "DateTimeField."]
  Note: "PackageFeature | Global/platform scope; AuditLog company is optional. Constraint: unique `(package, feature)`."
}

Table subscriptions_company_subscription {
  id bigint [pk, increment, not null, note: "Primary key; BigAutoField."]
  company_id bigint [not null, note: "TenantOwned.company; mandatory tenant ownership."]
  created_at timestamptz [not null, note: "Inherited timestamp."]
  updated_at timestamptz [not null, note: "Inherited timestamp."]
  created_by_id bigint [null, note: "Inherited ActorTracked field."]
  updated_by_id bigint [null, note: "Inherited ActorTracked field."]
  package_id bigint [not null, note: "FK -> Package, PROTECT."]
  subscription_reference varchar [not null, note: "CharField."]
  starts_at timestamptz [not null, note: "DateTimeField range."]
  ends_at timestamptz [not null, note: "DateTimeField range."]
  trial_ends_at timestamptz [null, note: "nullable DateTimeField."]
  cancelled_at timestamptz [null, note: "nullable DateTimeField."]
  status varchar [not null, note: "trial, active, past_due, suspended, cancelled, expired."]
  billing_interval varchar [not null, note: "CharField snapshot."]
  price_snapshot numeric(18,2) [not null, note: "DecimalField money."]
  currency varchar(3) [not null, note: "CharField(3)."]
  employee_limit_snapshot integer [null, note: "nullable PositiveIntegerField."]
  user_limit_snapshot integer [null, note: "nullable PositiveIntegerField."]
  device_limit_snapshot integer [null, note: "nullable PositiveIntegerField."]
  branch_limit_snapshot integer [null, note: "nullable PositiveIntegerField."]
  feature_snapshot jsonb [not null, note: "JSONField immutable commercial snapshot of feature codes and limits."]
  external_customer_id varchar [null, note: "optional CharField."]
  external_subscription_id varchar [null, note: "optional CharField."]
  auto_renew boolean [not null, note: "BooleanField."]
  cancellation_reason text [not null, note: "TextField, blank."]
  Note: "CompanySubscription | Direct company ownership. Constraints: unique `(company, subscription_reference)`; normally no overlapping active/trial subscriptions; entitlements use the subscription snapshot plus explicit CompanyFeature overrides. Capacity counting policy must define whether employees, users, or both are billable—the current recommendation is active employees."
}

Table auditlog_audit_log {
  id bigint [pk, increment, not null, note: "BigAutoField, PK."]
  company_id bigint [null, note: "nullable FK -> Company, PROTECT; null only for platform-level actions."]
  actor_user_id bigint [null, note: "nullable FK -> User, SET_NULL."]
  actor_membership_id bigint [null, note: "nullable FK -> CompanyMembership, SET_NULL."]
  actor_type varchar [not null, note: "user, system, device, background_job, root_admin."]
  action varchar [not null, note: "CharField stable code such as employee.updated or payroll_run.posted."]
  object_app varchar [not null, note: "CharField identifiers; use content types only if their operational tradeoff is accepted."]
  object_model varchar [not null, note: "CharField identifiers; use content types only if their operational tradeoff is accepted."]
  object_id varchar [not null, note: "CharField identifiers; use content types only if their operational tradeoff is accepted."]
  object_public_id varchar [not null, note: "CharField identifiers; use content types only if their operational tradeoff is accepted."]
  object_display varchar [not null, note: "CharField snapshot."]
  request_id varchar [null, note: "optional CharField, indexed."]
  correlation_id varchar [null, note: "optional CharField, indexed."]
  idempotency_key varchar [null, note: "optional CharField, indexed."]
  ip_address inet [null, note: "nullable GenericIPAddressField."]
  user_agent text [not null, note: "TextField, blank."]
  before_data jsonb [not null, note: "JSONField with sensitive values redacted."]
  after_data jsonb [not null, note: "JSONField with sensitive values redacted."]
  metadata jsonb [not null, note: "JSONField with sensitive values redacted."]
  occurred_at timestamptz [not null, note: "DateTimeField, indexed."]
  integrity_hash varchar [null, note: "optional CharField for tamper-evident chaining."]
  previous_hash varchar [null, note: "optional CharField for tamper-evident chaining."]
  Note: "AuditLog | Global/platform scope; AuditLog company is optional. "
}

Table accounts_company_membership_allowed_branches {
  id bigint [pk, increment, not null]
  companymembership_id bigint [not null]
  branch_id bigint [not null]
  indexes {
    (companymembership_id, branch_id) [unique]
  }
  Note: "CompanyMembership_allowed_branches | Parent-owned junction. Unique pair; both rows must belong to the same company. Tenant ownership is inherited from the source parent; this implicit junction has no company_id."
}

