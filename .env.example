# Environment configuration template for the attendance platform.
#
# Copy this file to `.env` in the project root and fill in real values:
#     Copy-Item .env.example .env      (PowerShell)
# `.env` is git-ignored and must never be committed. This template is committed
# and documents every key the project reads (config/settings.py via django-environ).

# --- Django core ---
# Debug mode. Never True in production.
DEBUG=True
# Cryptographic signing key. Generate a fresh random 50+ char value for real use:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-to-a-random-50-char-secret
# Comma-separated hostnames Django will serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
# Discrete settings; the password goes on its own line verbatim (no URL encoding).
# Matches the role/db from the setup commands (role "attendance", db "attendance_device").
POSTGRES_DB=attendance_device
POSTGRES_USER=attendance
POSTGRES_PASSWORD=your-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Seconds to keep a DB connection open for reuse (0 = new connection per request).
DB_CONN_MAX_AGE=60
