# Environment configuration template for the attendance platform.
#
# Copy this file to `.env` in the project root and fill in real values:
#     Copy-Item .env.example .env      (PowerShell)
# `.env` is git-ignored and must never be committed. This template is committed
# and documents every key the project reads (config/settings.py via django-environ).

# --- Django core ---
# Debug mode. Never True in production.
DEBUG=True
# Cryptographic signing key. Generate a fresh random 50+ char value for real use:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-to-a-random-50-char-secret
# Comma-separated hostnames Django will serve. A biometric device cannot reach
# localhost, so local device testing goes through a tunnel: add that hostname
# here too, e.g. ALLOWED_HOSTS=localhost,127.0.0.1,my-tunnel.ngrok-free.dev
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins trusted for browser form submissions. The device ingestion endpoints
# are CSRF-exempt and device-authenticated, but admin screens reached over the
# tunnel hostname are not. Wildcards are allowed.
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.dev,https://*.ngrok-free.app

# --- Biometric templates ---
# Encrypts the fingerprint/face templates kept on the server for copying to the
# company's other devices. Left blank, templates are refused, never stored
# unencrypted. Generate one per server and never commit a real key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes the saved templates unreadable; pull them from the device again.
BIOMETRIC_TEMPLATE_KEY=

# --- Database (PostgreSQL) ---
# Discrete settings; the password goes on its own line verbatim (no URL encoding).
# Matches the role/db from the setup commands (role "attendance", db "attendance_device").
POSTGRES_DB=attendance_device
POSTGRES_USER=attendance
POSTGRES_PASSWORD=your-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Seconds to keep a DB connection open for reuse (0 = new connection per request).
DB_CONN_MAX_AGE=60
